{% macro flash(type, message, close = false, use_raw = false, class = '', domain = 'TablerBundle') %}
    {% from "@Tabler/components/alert.html.twig" import alert %}
    {% if type == 'error' %}
        {% set type = 'danger' %}
    {% endif %}
    {{ alert({
        type: type,
        title: message|trans({}, domain|default('TablerBundle')),
        dismissible: close ?? false,
        important: true,
        raw: use_raw ?? false,
        class: class|default('')
    }) }}
{% endmacro %}

{% macro session_flash(close = false, use_raw = false, class = '', domain = 'TablerBundle') %}
    {{ _self.flashes(app.flashes, close, use_raw, class, domain) }}
{% endmacro %}

{% macro flashes(flashes, close = false, use_raw = false, class = '', domain = 'TablerBundle') %}
    {% for type, messages in flashes %}
        {% for message in messages %}
            {{ _self.flash(type, message, close, use_raw, class, domain) }}
        {% endfor %}
    {% endfor %}
{% endmacro %}
